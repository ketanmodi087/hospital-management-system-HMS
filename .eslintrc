{
  "settings": {
    "import/resolver": {
      "node": {
        "paths": ["src"],
        "extensions": [".js", ".jsx", ".ts", ".tsx"]
      },
      "alias": {
        "map": [["@components", "./src/components"]],
        "extensions": [".js", ".jsx", ".ts", ".tsx"]
      }
    }
  }
}
